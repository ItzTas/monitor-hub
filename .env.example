# Copy this file to .env and fill it in. Every value below is a placeholder.
#
# Lines that start with "# NAME=" are optional: remove the "# " to turn them on. Lines without
# the "# " are required. An empty value counts as not set.
# Do not put $ or quotes in values: Compose reads this file and treats them specially.
#
# Secrets (marked "secret") also accept NAME_FILE, the path of a file inside the container that
# holds the value; set one or the other, never both. The container has no secret files mounted
# unless you add a volume, so the plain NAME form is the one to use with the shipped compose.yaml.

# ---------------------------------------------------------------------------------------------
# 1. The hub
# ---------------------------------------------------------------------------------------------

# Required, secret. Postgres address of the hub's own database (not a plugin's). The hub creates
# its tables on start.
DATABASE_URL=postgres://monitor_hub:change-me@postgres:5432/monitor_hub?sslmode=disable

# Required, secret. Every /api route needs the header "Authorization: Bearer <API_TOKEN>".
API_TOKEN=change-me

# Optional, secret. Token for the RSS feed at /feed.xml?token=<FEED_TOKEN>. If you leave it unset,
# the feed is open to anyone who can reach the port.
# FEED_TOKEN=change-me

# Optional. Address the HTTP server listens on inside the container. Default: :8080.
# Leave it unset. The compose file publishes container port 8080, and an address like
# 127.0.0.1:8080 inside the container makes the published port dead while the healthcheck still
# passes.
# HTTP_ADDRESS=:8080

# Optional. Public address of the hub, used as the link in the RSS feed header.
# PUBLIC_URL=http://hub.lan

# Optional. debug, info, warn or error. Default: info.
# LOG_LEVEL=info

# Optional. Absolute path of the directory with the plugins baked into the image.
# Default: /opt/monitor-hub/plugins. Leave it alone.
# PLUGINS_DIR=/opt/monitor-hub/plugins

# Optional. Absolute path where the hub and the plugins keep their files. Default: /data, the
# volume the compose file mounts. Each plugin gets <DATA_DIR>/plugins/<name>.
# DATA_DIR=/data

# ---------------------------------------------------------------------------------------------
# 2. Notification channels
# A channel turns on when its first variable is set. With none set, events are stored but nothing
# is sent.
# ---------------------------------------------------------------------------------------------

# Telegram. On when TELEGRAM_TOKEN is set. The old gazette service called it TELEGRAM_BOT_TOKEN;
# the hub only reads TELEGRAM_TOKEN.
# Secret. Format 123456789:AAE...
# TELEGRAM_TOKEN=000000000:change-me-change-me-change-me
# Required with TELEGRAM_TOKEN. Numeric chat id (e.g. -1001234567890) or @channel_name.
# TELEGRAM_CHAT_ID=-1000000000000

# ntfy. On when NTFY_URL is set. The address ends with the topic.
# NTFY_URL=https://ntfy.example.invalid/change-me-topic
# Secret, optional.
# NTFY_TOKEN=change-me

# Email. On when SMTP_HOST is set. SMTP_FROM and SMTP_TO are then required.
# SMTP_HOST=smtp.example.invalid
# starttls, tls or none. Default: starttls. "none" is refused if a password is set.
# SMTP_TLS=starttls
# Default: 587 with starttls, 465 with tls, 25 with none.
# SMTP_PORT=587
# SMTP_USERNAME and SMTP_PASSWORD go together: set both or neither.
# SMTP_USERNAME=change-me
# Secret.
# SMTP_PASSWORD=change-me
# SMTP_FROM=monitor-hub@example.invalid
# One or more addresses, separated by commas.
# SMTP_TO=you@example.invalid

# Webhook. On when WEBHOOK_URL is set. WEBHOOK_SECRET is then required.
# WEBHOOK_URL=https://webhook.example.invalid/hook
# Secret, at least 16 characters. Signs the body with HMAC-SHA256.
# WEBHOOK_SECRET=change-me-change-me

# AMQP (RabbitMQ). On when AMQP_URL is set.
# Secret. amqp://user:password@host:5672/vhost or amqps://..., with special characters in the
# password percent-encoded.
# AMQP_URL=amqp://monitor_hub:change-me@rabbitmq.example.invalid:5672/
# Default: monitor-hub (the old sei-monitor service used "sei-monitor"). The routing key is
# <plugin>.<kind> for one event and <plugin>.batch for several, and the body is {"events":[...]}.
# A consumer bound to the old "sei-monitor" exchange must bind to the new one, or you set
# AMQP_EXCHANGE=sei-monitor and bind to the new routing keys.
# AMQP_EXCHANGE=monitor-hub

# WhatsApp. On when WHATSAPP_RECIPIENTS is set. Phone numbers with country and area code, or group
# ids ending in @g.us, separated by commas.
# The sending account must be paired once: stop the hub, run "monitor-hub whatsapp-pair" (see
# docs/deploy.md), then start the hub. If you pair while the hub runs, restart it afterwards.
# WHATSAPP_RECIPIENTS=5500000000000

# ---------------------------------------------------------------------------------------------
# 3. The plugins
# The hub gives a plugin only the variables that start with its prefix, with the prefix removed:
# SEI__SEI_URL reaches the "sei" plugin as SEI_URL, DIARIO__WATCH_TERMS reaches "diario" as
# WATCH_TERMS. A plugin also gets the hub's PATH and TZ, TMPDIR=/tmp and MONITOR_HUB_DATA_DIR
# (<DATA_DIR>/plugins/<name>). It gets nothing else from this file.
# ---------------------------------------------------------------------------------------------

# --- sei (the government process monitor) ---

# Required, secret. The sei plugin's own database: point it at the database the old sei-monitor
# already uses, so processes the old service saw are not announced again.
SEI__DATABASE_URL=postgres://sei_monitor:change-me@postgres:5432/sei_monitor?sslmode=disable
# SEI address, without /sei at the end. Must be https (http is accepted only for localhost).
SEI__SEI_URL=https://sei.example.invalid
# Optional. Address of the mod-wssei API. Only set it if automatic discovery fails.
# SEI__SEI_API_URL=https://sei-api.example.invalid
# Required.
SEI__SEI_USERNAME=change-me
# Required, secret: set exactly one of SEI_PASSWORD, SEI_PASSWORD_FILE and SEI_PASSWORD_CMD.
# The plugin refuses a value that is not valid UTF-8: this password, SEI__DATABASE_URL, the
# _FILE forms and what the password command prints.
SEI__SEI_PASSWORD=change-me
# SEI__SEI_PASSWORD_FILE=/run/secrets/sei_password
# Command that prints the password, run at every login, without a shell. It must exist inside
# the hub image, which has no password manager.
# SEI__SEI_PASSWORD_CMD=
# Required. Agency acronym or numeric id.
SEI__SEI_ORG=CHANGEME
# Optional. Unit acronyms separated by commas, or "all". Empty watches your current unit.
# SEI__SEI_UNITS=
# Optional. Time zone of the dates SEI shows. Default: America/Sao_Paulo.
# SEI__SEI_TIMEZONE=America/Sao_Paulo
# Optional. Simultaneous calls to the SEI API, 1 to 10. Default: 3.
# SEI__SEI_CONCURRENCY=3
# Optional. Time between checks, like 15m or 1h. Minimum 5m. Default: 15m.
# SEI__POLL_INTERVAL=15m
# Optional. minimal or full. Default: minimal. Full adds the process type and description, the
# activity text and the document name to the notification body.
# SEI__NOTIFICATION_DETAIL=minimal
# Optional. Days before a scheduled return to send a reminder, 0 to 60. Default: 2.
# SEI__RETURN_WARNING_DAYS=2
# Optional. Days to keep events and processes that left your units, 0 to 3650. Default: 90. Use
# at least RETURN_WARNING_DAYS + 2, or 0 to keep everything. The plugin never deletes an event
# the hub has not read yet.
# SEI__RETENTION_DAYS=90
# Optional. debug, info, warn or error. Default: info.
# SEI__LOG_LEVEL=info

# --- diario (the official gazette monitor) ---

# Required, secret. The gazette plugin's own database: point it at the database the old
# diario-alerr already uses. This plugin has no _FILE form. It connects without TLS, so use
# sslmode=disable or prefer; docs/deploy.md (step 3) lists what else the address and role need.
# Reset this database only together with the hub's stored position for "diario" (see
# docs/deploy.md). Reset alone, new alerts are never delivered.
DIARIO__DATABASE_URL=postgres://diario_alerr:change-me@postgres:5432/diario_alerr?sslmode=disable
# Required. Names or registration numbers to look for, separated by commas.
DIARIO__WATCH_TERMS=EXAMPLE NAME,00000
# Optional. Minutes between checks, a positive number. Default: 30.
# DIARIO__CHECK_INTERVAL_MINUTES=30
# Optional. The first check reads the editions published from 24 hours before this point on.
# A date (2026-11-01), an RFC 3339 timestamp, or a timestamp without a zone, read as UTC. Read
# only when the database has no state yet, so it does nothing on a database the old diario-alerr
# used. Default: 72 hours before the plugin starts.
# DIARIO__START_AFTER=2026-11-01
# Optional. Address of the gazette's media API. Default: built into the plugin. Leave it unset
# unless the gazette changes address.
# DIARIO__GAZETTE_API_URL=

# ---------------------------------------------------------------------------------------------
# 4. Compose settings
# Read by compose.yaml, not by the hub.
# ---------------------------------------------------------------------------------------------

# Image tag to run. Default: latest. Pin a version once you have one.
# MONITOR_HUB_TAG=latest
# Host address the port binds to. Default: 127.0.0.1.
# BIND_ADDRESS=127.0.0.1
# Host port. Default: 8090.
# APP_PORT=8090
# Time zone of the hub, which the plugins inherit. Default: America/Boa_Vista.
# TZ=America/Boa_Vista
