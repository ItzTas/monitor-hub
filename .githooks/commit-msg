#!/bin/sh

message_file="$1"
subject=$(grep -vE '^[[:space:]]*#' "$message_file" | grep -vE '^[[:space:]]*$' | head -n1)

case "$subject" in
"Merge "* | "Revert "* | "fixup! "* | "squash! "* | "amend! "*)
	exit 0
	;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^)]+\))?!?: .+'

if printf '%s\n' "$subject" | grep -qE "$pattern"; then
	exit 0
fi

cat >&2 <<'MESSAGE'
The commit message does not follow Conventional Commits.

  Format: <type>(<optional scope>): <description>
  Types:  feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
  Breaking change: add "!" after the type or scope (e.g. "feat!: ...") or a "BREAKING CHANGE:" footer.

  Examples:
    fix(gazette): retry the PDF download once
    docs: describe the ntfy payload
MESSAGE
exit 1
