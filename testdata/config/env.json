  {"name": "integer with a leading zero", "fields": [{"name": "n", "label": "N", "type": "integer", "env": "N"}],
   "env": {"N": "03"}, "document": {"n": 3}, "problems": null},
  {"name": "integer negative zero", "fields": [{"name": "n", "label": "N", "type": "integer", "env": "N"}],
   "env": {"N": "-0"}, "document": {"n": 0}, "problems": null},
  {"name": "integer with a leading space", "fields": [{"name": "n", "label": "Count", "type": "integer", "env": "N"}],
   "env": {"N": " 3"}, "document": null, "problems": [{"path": "n", "message": "N is not an integer (\" 3\")"}]},
  {"name": "integer with a fraction", "fields": [{"name": "n", "label": "N", "type": "integer", "env": "N"}],
   "env": {"N": "3.0"}, "document": null, "problems": [{"path": "n", "message": "N is not an integer (\"3.0\")"}]},
  {"name": "integer with an exponent", "fields": [{"name": "n", "label": "N", "type": "integer", "env": "N"}],
   "env": {"N": "1e2"}, "document": null, "problems": [{"path": "n", "message": "N is not an integer (\"1e2\")"}]},
  {"name": "integer beyond i64", "fields": [{"name": "n", "label": "N", "type": "integer", "env": "N"}],
   "env": {"N": "9223372036854775808"}, "document": null, "problems": [{"path": "n", "message": "N is not an integer (\"9223372036854775808\")"}]},

  {"name": "number with a fraction", "fields": [{"name": "x", "label": "X", "type": "number", "env": "X"}],
   "env": {"X": "1.5"}, "document": {"x": 1.5}, "problems": null},
  {"name": "number without an integer part", "fields": [{"name": "x", "label": "X", "type": "number", "env": "X"}],
   "env": {"X": ".5"}, "document": {"x": 0.5}, "problems": null},
  {"name": "number without a fractional part", "fields": [{"name": "x", "label": "X", "type": "number", "env": "X"}],
   "env": {"X": "5."}, "document": {"x": 5.0}, "problems": null},
  {"name": "number with an exponent", "fields": [{"name": "x", "label": "X", "type": "number", "env": "X"}],
   "env": {"X": "1e3"}, "document": {"x": 1000.0}, "problems": null},
  {"name": "number without a point", "fields": [{"name": "x", "label": "X", "type": "number", "env": "X"}],
   "env": {"X": "-2"}, "document": {"x": -2.0}, "problems": null},
  {"name": "number NaN", "fields": [{"name": "x", "label": "X", "type": "number", "env": "X"}],
   "env": {"X": "NaN"}, "document": null, "problems": [{"path": "x", "message": "X is not a number (\"NaN\")"}]},
  {"name": "number inf", "fields": [{"name": "x", "label": "X", "type": "number", "env": "X"}],
   "env": {"X": "inf"}, "document": null, "problems": [{"path": "x", "message": "X is not a number (\"inf\")"}]},
  {"name": "hexadecimal number", "fields": [{"name": "x", "label": "X", "type": "number", "env": "X"}],
