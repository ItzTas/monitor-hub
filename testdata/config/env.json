  {"name": "number with an underscore", "fields": [{"name": "x", "label": "X", "type": "number", "env": "X"}],
   "env": {"X": "1_0"}, "document": null, "problems": [{"path": "x", "message": "X is not a number (\"1_0\")"}]},
  {"name": "number beyond f64", "fields": [{"name": "x", "label": "X", "type": "number", "env": "X"}],
   "env": {"X": "1e999"}, "document": null, "problems": [{"path": "x", "message": "X is not a number (\"1e999\")"}]},
  {"name": "number with a leading space", "fields": [{"name": "x", "label": "X", "type": "number", "env": "X"}],
   "env": {"X": " 1"}, "document": null, "problems": [{"path": "x", "message": "X is not a number (\" 1\")"}]},

  {"name": "boolean true", "fields": [{"name": "b", "label": "B", "type": "boolean", "env": "B"}],
   "env": {"B": "true"}, "document": {"b": true}, "problems": null},
  {"name": "boolean false", "fields": [{"name": "b", "label": "B", "type": "boolean", "env": "B"}],
   "env": {"B": "false"}, "document": {"b": false}, "problems": null},
  {"name": "boolean with a capital", "fields": [{"name": "b", "label": "B", "type": "boolean", "env": "B"}],
   "env": {"B": "True"}, "document": null, "problems": [{"path": "b", "message": "B is not true or false (\"True\")"}]},
  {"name": "boolean as a digit", "fields": [{"name": "b", "label": "B", "type": "boolean", "env": "B"}],
   "env": {"B": "1"}, "document": null, "problems": [{"path": "b", "message": "B is not true or false (\"1\")"}]},
  {"name": "boolean with a leading space", "fields": [{"name": "b", "label": "B", "type": "boolean", "env": "B"}],
   "env": {"B": " true"}, "document": null, "problems": [{"path": "b", "message": "B is not true or false (\" true\")"}]},

  {"name": "choice in capitals", "fields": [{"name": "mode", "label": "Mode", "type": "choice", "options": ["full", "summary"], "env": "MODE"}],
   "env": {"MODE": "FULL"}, "document": {"mode": "FULL"}, "problems": null},
  {"name": "choice with spaces", "fields": [{"name": "mode", "label": "Mode", "type": "choice", "options": ["full", "summary"], "env": "MODE"}],
   "env": {"MODE": " full "}, "document": {"mode": " full "}, "problems": null},
  {"name": "duration with spaces", "fields": [{"name": "d", "label": "D", "type": "duration", "env": "D"}],
   "env": {"D": " 10m "}, "document": {"d": " 10m "}, "problems": null},

  {"name": "list of string with spaces and empty pieces", "fields": [{"name": "l", "label": "L", "type": "list", "items": {"type": "string"}, "env": "L"}],
   "env": {"L": " a , b ,,"}, "document": {"l": ["a", "b"]}, "problems": null},
  {"name": "list of a comma alone", "fields": [{"name": "l", "label": "L", "type": "list", "items": {"type": "string"}, "env": "L"}],
   "env": {"L": ","}, "document": {"l": []}, "problems": null},
  {"name": "list of string with Unicode spaces", "fields": [{"name": "l", "label": "L", "type": "list", "items": {"type": "string"}, "env": "L"}],
   "env": {"L": "\ta\t,\u00a0b\u00a0,\u3000c\u3000"}, "document": {"l": ["a", "b", "c"]}, "problems": null},
  {"name": "list of integer with bad text", "fields": [{"name": "n", "label": "N", "type": "list", "items": {"type": "integer"}, "env": "N"}],
   "env": {"N": "1, x"}, "document": null, "problems": [{"path": "n[1]", "message": "N is not an integer (\"x\")"}]},
  {"name": "list of integer with bad text after an empty piece", "fields": [{"name": "n", "label": "N", "type": "list", "items": {"type": "integer"}, "env": "N"}],
   "env": {"N": "1, ,x"}, "document": null, "problems": [{"path": "n[1]", "message": "N is not an integer (\"x\")"}]},
  {"name": "list of choice", "fields": [{"name": "c", "label": "C", "type": "list", "items": {"type": "choice", "options": ["urgent", "ignore"]}, "env": "C"}],
   "env": {"C": "urgent, Other"}, "document": {"c": ["urgent", "Other"]}, "problems": null},

  {"name": "object built from the defaults of its fields", "fields": [{"name": "o", "label": "O", "type": "object", "fields": [{"name": "a", "label": "A", "type": "string", "default": "x"}, {"name": "b", "label": "B", "type": "string"}]}],
   "env": {}, "document": {"o": {"a": "x"}}, "problems": null},
  {"name": "object whose fields have no default", "fields": [{"name": "o", "label": "O", "type": "object", "fields": [{"name": "a", "label": "A", "type": "string"}]}],
   "env": {}, "document": {}, "problems": null},

  {"name": "text with a quote", "fields": [{"name": "n", "label": "N", "type": "integer", "env": "N"}],
   "env": {"N": "a\"b"}, "document": null, "problems": [{"path": "n", "message": "N is not an integer (\"a\\\"b\")"}]},
  {"name": "text with a line break", "fields": [{"name": "n", "label": "N", "type": "integer", "env": "N"}],
   "env": {"N": "a\nb"}, "document": null, "problems": [{"path": "n", "message": "N is not an integer (\"a\\nb\")"}]},
  {"name": "text with a control character", "fields": [{"name": "n", "label": "N", "type": "integer", "env": "N"}],
   "env": {"N": "a\u0001b"}, "document": null, "problems": [{"path": "n", "message": "N is not an integer (\"a\\u0001b\")"}]},
  {"name": "text with HTML characters", "fields": [{"name": "n", "label": "N", "type": "integer", "env": "N"}],
   "env": {"N": "<a&b>"}, "document": null, "problems": [{"path": "n", "message": "N is not an integer (\"<a&b>\")"}]},
  {"name": "text with a line separator", "fields": [{"name": "n", "label": "N", "type": "integer", "env": "N"}],
   "env": {"N": "a\u2028b"}, "document": null, "problems": [{"path": "n", "message": "N is not an integer (\"a\u2028b\")"}]},
  {"name": "text with a paragraph separator", "fields": [{"name": "n", "label": "N", "type": "integer", "env": "N"}],
   "env": {"N": "a\u2029b"}, "document": null, "problems": [{"path": "n", "message": "N is not an integer (\"a\u2029b\")"}]},
  {"name": "two problems in declaration order", "fields": [{"name": "b", "label": "B", "type": "integer", "env": "B"}, {"name": "a", "label": "A", "type": "boolean", "env": "A"}],
   "env": {"A": "x", "B": "y"}, "document": null, "problems": [{"path": "b", "message": "B is not an integer (\"y\")"}, {"path": "a", "message": "A is not true or false (\"x\")"}]},
  {"name": "secret integer with bad text", "fields": [{"name": "pin", "label": "Card PIN", "type": "integer", "secret": true, "env": "PIN"}],
   "env": {"PIN": "12a4"}, "document": null, "problems": [{"path": "pin", "message": "PIN is not an integer"}]},
  {"name": "secret number with bad text", "fields": [{"name": "rate", "label": "Rate", "type": "number", "secret": true, "env": "RATE"}],
   "env": {"RATE": "1,5"}, "document": null, "problems": [{"path": "rate", "message": "RATE is not a number"}]},
  {"name": "secret boolean with bad text", "fields": [{"name": "flag", "label": "Flag", "type": "boolean", "secret": true, "env": "FLAG"}],
   "env": {"FLAG": "yes"}, "document": null, "problems": [{"path": "flag", "message": "FLAG is not true or false"}]}
]}
