{"cases": [
  {"name": "empty text with a default", "fields": [{"name": "s", "label": "S", "type": "string", "default": "d", "env": "S"}],
   "env": {"S": ""}, "document": {"s": "d"}, "problems": null},
  {"name": "empty text without a default", "fields": [{"name": "s", "label": "S", "type": "string", "env": "S"}],
   "env": {"S": ""}, "document": {}, "problems": null},
  {"name": "text with a default", "fields": [{"name": "s", "label": "S", "type": "string", "default": "d", "env": "S"}],
   "env": {"S": "x"}, "document": {"s": "x"}, "problems": null},
  {"name": "an unset variable with a default", "fields": [{"name": "s", "label": "S", "type": "string", "default": "d", "env": "S"}],
   "env": {}, "document": {"s": "d"}, "problems": null},
  {"name": "a string of spaces", "fields": [{"name": "s", "label": "S", "type": "string", "env": "S"}],
   "env": {"S": "  "}, "document": {"s": "  "}, "problems": null},

  {"name": "integer with a sign", "fields": [{"name": "n", "label": "N", "type": "integer", "env": "N"}],
